[
  {
    "name": "list_drafts",
    "method": "GET",
    "path": "/api/drafts",
    "description": "List team drafts. Drafts never enter the delivery queue.",
    "readOnly": true,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_draft",
    "method": "GET",
    "path": "/api/drafts/:draftId",
    "description": "Read a draft's text, selected accounts, overrides and ordered media.",
    "readOnly": true,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "draftId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["draftId"],
      "additionalProperties": false
    }
  },
  {
    "name": "save_draft",
    "method": "POST",
    "path": "/api/drafts/:draftId",
    "description": "Save incomplete content without publishing. Use version 0 and a new draftId for a new draft, or its current version to update. Reuse the request key for retries.",
    "readOnly": false,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 64000 },
        "textOverrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "additionalProperties": { "type": "string", "maxLength": 64000 }
        },
        "connectionIds": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "mediaIds": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        },
        "draftId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "text",
        "textOverrides",
        "connectionIds",
        "mediaIds",
        "version",
        "idempotencyKey",
        "draftId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_draft",
    "method": "DELETE",
    "path": "/api/drafts/:draftId",
    "description": "Delete a team draft using its current version. Ask the user before deleting their draft.",
    "readOnly": false,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
