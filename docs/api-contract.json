  {
    "name": "reserve_media_upload",
    "method": "POST",
    "path": "/api/media/uploads",
    "description": "Reserve a private image or video upload. PUT the approved file to the returned URL using its headers, then complete the upload. No post is created.",
    "readOnly": false,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "contentType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "video/mp4",
            "video/quicktime"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "alt": { "default": "", "type": "string", "maxLength": 2000 }
      },
      "required": ["fileName", "contentType", "sizeBytes", "alt"],
      "additionalProperties": false
    }
  },
  {
    "name": "complete_media_upload",
    "method": "POST",
