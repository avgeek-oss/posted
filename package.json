{
  "name": "posted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch apps/api/src/index.ts",
    "dev:preview": "node --env-file=.env --import tsx --watch tools/local-preview-api.ts",
    "dev:web": "pnpm --filter @posted/web dev",
    "build": "pnpm --filter @posted/web build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/index.js",
    "migrate": "node --env-file=.env --import tsx packages/database/src/migrate-cli.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @posted/web exec tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "verify": "pnpm docs:check && pnpm release:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:operations && pnpm test && pnpm audit --audit-level=moderate && pnpm build",
    "recover-account": "node --env-file=.env --import tsx apps/api/src/auth/recovery-cli.ts",
    "dev:worker": "node --env-file=.env --import tsx apps/worker/src/index.ts",
    "docs:build": "node --import tsx tools/build-api-docs.ts && node tools/build-mintlify-docs.mjs",
    "docs:check": "node --import tsx tools/build-api-docs.ts --check && node tools/build-mintlify-docs.mjs --check && node tools/docs-check.mjs",
    "docs:validate": "cd docs && npx --yes mint@4.2.970 validate && npx --yes mint@4.2.970 broken-links --check-snippets",
    "docs:dev": "pnpm docs:build && cd docs && npx --yes mint@4.2.970 dev --port 4177",
    "docs:preview": "node --env-file=.env --import tsx tools/docs-preview.ts",
    "release:check": "node tools/release-validate.mjs",
    "test:operations": "node --test tools/*.test.mjs",
    "verify:production": "node tools/production-verify.mjs"
  },
  "dependencies": {
    "@atproto/api": "0.24.3",
    "@atproto/oauth-client-node": "0.5.9",
    "@avgeek-oss/design-system": "1.2.17",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@simplewebauthn/server": "13.3.2",
    "file-type": "22.1.1",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "nodemailer": "10.0.15",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "twitter-text": "3.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@avgeek-oss/mintlify-docs": "0.1.6",
    "@eslint/js": "9.39.4",
    "@mdx-js/mdx": "3.1.1",
    "@types/node": "26.6.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/twitter-text": "3.1.10",
    "eslint": "9.39.4",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "yaml": "2.8.3"
  }
}
