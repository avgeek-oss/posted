DATABASE_URL=postgres://posted:replace-with-password@localhost:5432/posted
POSTED_SECRET=replace-with-at-least-32-random-characters
POSTED_WEB_URL=https://posted.example.com
POSTED_API_URL=https://posted-api.example.com
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password

# Complete both values to enable a provider in Add connection.
POSTED_X_CLIENT_ID=
POSTED_X_CLIENT_SECRET=
POSTED_LINKEDIN_CLIENT_ID=
POSTED_LINKEDIN_CLIENT_SECRET=
# Separate Community Management API application for LinkedIn Pages.
POSTED_LINKEDIN_PAGES_CLIENT_ID=
POSTED_LINKEDIN_PAGES_CLIENT_SECRET=
POSTED_THREADS_CLIENT_ID=
POSTED_THREADS_CLIENT_SECRET=
# The Bluesky client ID is the public HTTPS client-metadata.json URL.
POSTED_BLUESKY_CLIENT_ID=
POSTED_BLUESKY_PRIVATE_KEY_JWK=

# Optional private S3-compatible media storage; set all four credentials/locations.
POSTED_S3_ENDPOINT=
POSTED_S3_REGION=auto
POSTED_S3_BUCKET=
POSTED_S3_ACCESS_KEY_ID=
POSTED_S3_SECRET_ACCESS_KEY=

# Optional account emails. Include Posted's sender display name.
POSTED_SMTP_HOST=
POSTED_SMTP_PORT=587
POSTED_SMTP_SECURE=false
POSTED_SMTP_USER=
POSTED_SMTP_PASSWORD=
POSTED_SMTP_FROM=
